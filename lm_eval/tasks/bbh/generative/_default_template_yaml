include: ../../templates/generative_template.yaml
dataset_path: lukaemon/bbh
test_split: test
doc_to_text: "{{input}}"
doc_to_target: "{{target}}"
num_fewshot: 0
metadata:
  version: 3.0

filter_list:
  - name: "extract_answer_nous"
    filter:
      - function: "extract_answer_nous"
        bounds:
          - left_bound: "</think>"
            include_bounds: false
            case_insensitive: true
      - function: "extract_answer_nous"
        bounds:
          - left_bound: <answer>
            right_bound: </answer>
            include_bounds: false
            case_insensitive: true
          - left_bound: "answer: "
            right_bound: ""
            include_bounds: false
            case_insensitive: true
          - left_bound: "answer: "
            right_bound: "**"
            include_bounds: false
            case_insensitive: true
