include: ../../templates/generative_template.yaml
dataset_path: lukaemon/bbh
test_split: test
doc_to_text: "{{input}}"
doc_to_target: "{{target}}"
num_fewshot: 0
metadata:
  version: 3.0

filter_list:
  - name: "extract_answer_nous_with_optional_mc_regex"
    filter:
      - function: "extract_answer_nous"
        bounds:
          - left_bound: "</think>\n\n"
            include_bounds: false
            case_insensitive: true
          - left_bound: <answer>
            right_bound: </answer>
            include_bounds: false
            case_insensitive: true
          - left_bound: "answer: "
            include_bounds: false
            case_insensitive: true
          - left_bound: "answer:"
            include_bounds: false
            case_insensitive: true
          - left_bound: "answer: "
            right_bound: "**"
            include_bounds: false
            case_insensitive: true
          - left_bound: "answer**: "
            include_bounds: false
            case_insensitive: true
          - left_bound: "answer:** "
            include_bounds: false
            case_insensitive: true
          - left_bound: "the final answer is "
            right_bound: "."
            include_bounds: false
            case_insensitive: true
          - left_bound: "\\boxed{"
            right_bound: "}"
            include_bounds: false
            case_insensitive: true
          - left_bound: "\\text{"
            right_bound: "}"
            include_bounds: false
            case_insensitive: true
      - function: "regex_fallback_to_original_nous"
        regex_pattern: \(([A-Za-z])\)
      - function: "regex_fallback_to_original_nous"
        regex_pattern: ^([A-Z])(?:[.)]|\.\s|\s*\()
      - function: "regex_fallback_to_original_nous"
        regex_pattern: (?i)\b(yes|no|true|false|valid|invalid)\b
      - function: "regex_fallback_to_original_nous"
        regex_pattern: \*\*(.*?)\*\*
